        "jsonBody": "={\n  \"text\": \"⚠️ *Duplicate Lead Received (No Email Consent)*\\n*Name:* {{ $('Validate Input').first().json.client_name }}\\n*Email:* {{ $('Validate Input').first().json.client_email }}\\n*Company:* {{ $('Validate Input').first().json.company_name }}\\n*Budget:* {{ $('Validate Input').first().json.project_budget }}\\n_Note: Customer opted out of automated AI proposal emails._\"\n}",
