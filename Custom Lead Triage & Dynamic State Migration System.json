    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\n\n// Extract and trim fields\nconst email = body.client_email ? String(body.client_email).trim() : '';\nconst name = body.client_name ? String(body.client_name).trim() : '';\nconst company = body.company_name ? String(body.company_name).trim() : '';\nconst budget = body.project_budget ? String(body.project_budget).trim() : '$0';\nconst consent = body.consent === true || body.consent === 'true' || body.consent === 'on';\n\n// Email regex pattern validation\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst isValidEmail = emailRegex.test(email);\nconst hasRequiredFields = name.length > 0 && company.length > 0;\n\nreturn [{\n  json: {\n    is_valid: isValidEmail && hasRequiredFields,\n    client_email: email,\n    client_name: name,\n    company_name: company,\n    project_budget: budget,\n    consent: consent,\n    validation_error: !isValidEmail ? 'Invalid email format' : (!hasRequiredFields ? 'Missing required fields' : null)\n  }\n}];"
      },
