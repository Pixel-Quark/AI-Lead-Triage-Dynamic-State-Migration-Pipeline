    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Extract raw text string from Gemini's nested response format\nlet rawText = \"\";\nif (input.content?.parts?.[0]?.text) {\n  rawText = input.content.parts[0].text;\n} else if (input.text) {\n  rawText = input.text;\n} else {\n  rawText = JSON.stringify(input);\n}\n\n// Clean markdown code blocks if Gemini included them\nconst cleanedText = rawText.replace(/```json\\n?|```/g, '').trim();\n\nlet parsed = {};\ntry {\n  parsed = JSON.parse(cleanedText);\n} catch (e) {\n  parsed = {\n    budget_score: 10,\n    intent_score: 10,\n    fit_score: 10,\n    summary: rawText\n  };\n}\n\nreturn [{ json: parsed }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2096,
        -144
      ],
      "id": "6d09aab0-d19e-4bce-9ba8-ec6e58ad55a6",
      "name": "Parse AI Output"
    },
    {
      "parameters": {
        "jsCode": "const aiItem = $input.first() ? $input.first().json : {};\nconst validateInput = $('Validate Input').first() ? $('Validate Input').first().json : {};\n\n// Extract numbers dynamically (no manual overrides)\nconst budget = parseInt(aiItem.budget_score || 0, 10);\nconst intent = parseInt(aiItem.intent_score || 0, 10);\nconst fit = parseInt(aiItem.fit_score || 0, 10);\n\nconst totalScore = budget + intent + fit;\nconst isHigh = totalScore >= 70;\n\nreturn [\n  {\n    json: {\n      ...validateInput,\n      budget_score: budget,\n      intent_score: intent,\n      fit_score: fit,\n      final_score: totalScore,\n      is_high_priority: isHigh,\n      priority_tag: isHigh ? \"High Priority\" : \"Low Priority\",\n      ai_summary: aiItem.summary || \"No summary provided\"\n    }\n  }\n];"
      },
