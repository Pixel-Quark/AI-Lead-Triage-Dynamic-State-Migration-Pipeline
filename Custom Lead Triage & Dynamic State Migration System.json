    {
      "parameters": {
        "jsCode": "const raw = $('Validate Input').first().json;\n\n// Format name to Title Case\nconst cleanName = raw.client_name\n  ? raw.client_name.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')\n  : '';\n\n// Parse numeric budget safely\nconst numericBudget = typeof raw.project_budget === 'string'\n  ? parseInt(raw.project_budget.replace(/[^0-9]/g, ''), 10) || 0\n  : Number(raw.project_budget || 0);\n\nreturn [{\n  json: {\n    client_name: cleanName,\n    client_email: raw.client_email ? raw.client_email.toLowerCase() : '',\n    company_name: raw.company_name ? raw.company_name.trim().toUpperCase() : '',\n    project_budget: numericBudget,\n    timeline: raw.timeline || \"Not specified\",\n    project_details: raw.project_details || \"No details provided\",\n    consent: raw.consent,\n    is_duplicate: false\n  }\n}];"
      },
