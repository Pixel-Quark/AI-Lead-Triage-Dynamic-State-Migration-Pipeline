        "jsCode": "const mergeData = $('Merge Sheet Lookups').first().json;\nconst scoreData = $('Calculate Final Score').first().json;\nconst parseData = $('Parse AI Output').first().json;\n\n// Explicitly retrieve tab location and check if duplicate exists\nconst oldTab = mergeData.found_in_tab || null; \nconst newTab = scoreData.priority_tag || \"High Priority\"; \nconst rowNum = mergeData.row_number || null;\nconst isDuplicate = mergeData.is_duplicate === true;\n\n// Only flag tab_changed as true IF it is a duplicate AND the tab actually moved\nconst tabChanged = isDuplicate && oldTab !== null && oldTab !== newTab;\n\nreturn [{\n  json: {\n    ...$json,\n    ...scoreData,\n    ...parseData,\n    old_tab: oldTab,\n    new_tab: newTab,\n    row_number_to_delete: rowNum,\n    tab_changed: tabChanged\n  }\n}];"
