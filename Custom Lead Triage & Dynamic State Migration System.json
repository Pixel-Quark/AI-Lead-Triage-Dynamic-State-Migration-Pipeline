        "jsCode": "const highResults = $node[\"Search High Priority\"] ? $('Search High Priority').all() : [];\nconst lowResults = $node[\"Search Low Priority\"] ? $('Search Low Priority').all() : [];\n\nconst highMatch = highResults.find(item => item.json && item.json[\"Client Email\"] && item.json[\"Client Email\"].trim() !== \"\");\nconst lowMatch = lowResults.find(item => item.json && item.json[\"Client Email\"] && item.json[\"Client Email\"].trim() !== \"\");\n\nlet match = highMatch ? highMatch.json : (lowMatch ? lowMatch.json : null);\nlet tabSource = highMatch ? \"High Priority\" : (lowMatch ? \"Low Priority\" : null);\n\nconst inputBudget = $('Validate Input').first().json.project_budget;\nconst newBudget = Number(inputBudget || 0);\n\nif (match) {\n  const oldBudget = Number(match[\"Project Budget\"] || 0);\n  const rowNum = match.row_number || match.row_id || 2;\n\n  return [{\n    json: {\n      ...match,\n      found_in_tab: tabSource,\n      row_number: rowNum,\n      is_duplicate: true,\n      old_budget: oldBudget,\n      new_budget: newBudget,\n      budget_changed: newBudget !== oldBudget\n    }\n  }];\n}\n\n// Strictly mark as NOT duplicate for new leads\nreturn [{\n  json: {\n    is_duplicate: false,\n    found_in_tab: null,\n    new_budget: newBudget\n  }\n}];"
